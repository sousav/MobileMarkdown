# Android signing configuration for release builds.
# Copy this file to key.properties and fill in your values.
# NEVER commit key.properties to version control.
#
# To generate a keystore:
#   keytool -genkey -v -keystore ~/mobilemarkdown-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias upload
#
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/path/to/your/mobilemarkdown-upload.jks
